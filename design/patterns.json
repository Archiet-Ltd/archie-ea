{
  "pilot_patterns": {
    "overview": {
      "pattern": "dashboard-01",
      "structure": [
        "kpi-band",
        "answer-cascade",
        "chart",
        "dense-table"
      ]
    },
    "list": {
      "pattern": "data-table",
      "structure": [
        "action-bar",
        "quiet-alert",
        "dense-table"
      ]
    },
    "focused_task": {
      "pattern": "command",
      "structure": [
        "large-input",
        "suggestion-chips",
        "answer-cascade"
      ]
    },
    "form": {
      "pattern": "single-column",
      "structure": [
        "page-header",
        "form-body",
        "form-footer"
      ],
      "rules": [
        "label-above-input",
        "inline-validation",
        "right-aligned-actions"
      ]
    },
    "dialog": {
      "pattern": "centered-modal",
      "structure": [
        "overlay",
        "dialog-header",
        "dialog-body",
        "dialog-footer"
      ],
      "rules": [
        "no-shadows",
        "hairline-border",
        "8px-radius"
      ]
    },
    "matrix": {
      "pattern": "dense-table-matrix",
      "parent": "dense-table",
      "spec": {
        "sticky_header": true,
        "sticky_left_column": true,
        "pagination": false,
        "cell_states": [
          "empty",
          "single-value",
          "multiple-count",
          "not-recorded"
        ],
        "legend_required": true,
        "filters": "form_field",
        "one_value_kind_per_grid": "a matrix shows one kind of value in every filled cell: a count matrix shows numbers (a single relationship reads 1, its type in the cell title); a label matrix shows labels",
        "row_header": "sentence case, 14px, weight 500, normal tracking (not the column headers' uppercase)"
      },
      "banned": [
        "observable",
        "d3-chord",
        "d3-sankey",
        "composer-matrix",
        "paginated-matrix"
      ]
    },
    "sidebar": {
      "pattern": "sidebar-07",
      "children": [
        "sidebar-menu-sub"
      ],
      "macros": "components/ui_sidebar.html: sidebar_wrapper, sidebar, sidebar_gap, sidebar_container, sidebar_inner, sidebar_header, sidebar_content, sidebar_footer, sidebar_group, sidebar_group_label, sidebar_menu, sidebar_menu_item, sidebar_menu_button, sidebar_menu_sub, sidebar_menu_sub_item, sidebar_menu_sub_button, sidebar_menu_badge, sidebar_rail, sidebar_inset, sidebar_trigger",
      "spec": {
        "levels": 2,
        "source": "flask-basecoat b327186: the sidebar parts and the sidebar-07 block, vendored with the Tailwind 3 spellings",
        "collapsible": "icon: the trigger, Ctrl/Cmd+B and the rail fold the sidebar to a 3rem icon rail; the state is the sidebar_state cookie",
        "rail_tooltips": "each menu button names itself in a tooltip beside its icon while the sidebar is folded",
        "phone": "below 768px the sidebar is a drawer opened by the trigger: Tab stays inside, Escape closes it and returns focus to the trigger",
        "group_label": "sentence case, 12px, weight 500, muted, role=heading level 3",
        "menu_button": "32px row, 14px, 16px icon, aria-current=page and data-active on the current page",
        "menu_sub": "one level under an entry, hidden in the icon rail"
      },
      "banned": [
        "sidebar-third-level",
        "exclusive-accordion",
        "hover-flyout-on-desktop",
        "second-sidebar-element"
      ]
    },
    "record_detail": {
      "pattern": "record-detail",
      "structure": [
        "page-header",
        "detail-meta",
        "sections",
        "related-records"
      ],
      "rules": [
        "actions-in-header",
        "one-column-on-narrow",
        "every-link-lands-on-content"
      ]
    },
    "settings": {
      "pattern": "settings-sections",
      "structure": [
        "page-header",
        "section-nav",
        "form-body",
        "form-footer"
      ],
      "rules": [
        "one-section-per-panel",
        "label-above-input",
        "right-aligned-actions"
      ]
    },
    "conversation": {
      "pattern": "conversation",
      "structure": [
        "thread",
        "answer-cascade",
        "composer"
      ],
      "rules": [
        "sources-under-every-answer",
        "composer-pinned-to-bottom"
      ]
    },
    "board": {
      "pattern": "board",
      "structure": [
        "action-bar",
        "columns",
        "cards"
      ],
      "rules": [
        "column-heading-with-count",
        "keyboard-move",
        "empty-column-says-why"
      ]
    },
    "onboarding": {
      "pattern": "onboarding",
      "structure": [
        "brand",
        "single-card",
        "form-body",
        "next-step"
      ],
      "rules": [
        "one-task-per-screen",
        "label-above-input"
      ]
    },
    "public": {
      "pattern": "public-page",
      "structure": [
        "public-navbar",
        "hero",
        "sections",
        "public-footer"
      ],
      "rules": [
        "public-palette-scoped"
      ]
    },
    "empty_state": {
      "pattern": "empty-state",
      "structure": [
        "page-header",
        "empty-state"
      ],
      "rules": [
        "says-why-it-is-empty",
        "offers-the-next-step"
      ]
    },
    "site_nav": {
      "pattern": "disclosure-navigation",
      "structure": [
        "skip-link",
        "wordmark",
        "top-level-entries",
        "site-cta",
        "account"
      ],
      "rules": [
        "registry-driven",
        "sticky-h-16-hairline",
        "no-shadow",
        "one-site-primary",
        "disclosure-not-menu-role"
      ],
      "spec": {
        "height": "h-16",
        "breakpoint": "lg",
        "mobile": "header-disclosure-panel",
        "cta": "primary, data-site-cta",
        "signin": "ghost",
        "registry": "content/site/registry.yml read by site_registry()"
      },
      "banned": [
        "side-drawers",
        "full-screen-modals",
        "drop-shadows",
        "literal-link-lists"
      ]
    },
    "mega_menu": {
      "pattern": "grouped-icon-rows",
      "parent": "site_nav",
      "structure": [
        "group-heading",
        "item-row",
        "see-all",
        "early-access-group"
      ],
      "spec": {
        "item": "icon + label + blurb<=80 chars",
        "max_items_per_group": 8,
        "early_access_group": "last, dashed hairline, muted icon, heading Coming soon"
      },
      "banned": [
        "card-grid-navigation",
        "tooltip-only-descriptions"
      ]
    },
    "site_footer": {
      "pattern": "site-map",
      "structure": [
        "brand-line",
        "registry-rows",
        "bottom-bar"
      ],
      "rules": [
        "registry-driven",
        "max-12-links-per-column",
        "links-look-like-links",
        "coming-soon-column-last",
        "labels-equal-navbar-labels"
      ],
      "banned": [
        "literal-link-lists",
        "fake-link-spans"
      ]
    }
  },
  "banned_patterns": [
    "card-grid-navigation",
    "accordion-faq",
    "equal-weight-action-bars",
    "full-width-warning-banners",
    "multi-column-forms",
    "drop-shadows",
    "icons-inside-kpi-cards",
    "mermaid",
    "force-directed-graph",
    "page-level-d3",
    "side-drawers",
    "full-screen-modals",
    "floating-labels",
    "observable",
    "d3-chord",
    "d3-sankey",
    "composer-matrix",
    "paginated-matrix",
    "sidebar-third-level",
    "exclusive-accordion",
    "literal-link-lists",
    "fake-link-spans",
    "placeholder-screenshots",
    "screenshots-on-early-access",
    "gradient-backgrounds",
    "decorative-blur",
    "hover-lift"
  ],
  "public_scope": [
    "app/templates/components/public_navbar.html",
    "app/templates/components/public_menu.html",
    "app/templates/components/public_footer.html"
  ],
  "public_icons": [
    "arrow-right",
    "arrow-up-right",
    "book-open",
    "boxes",
    "building-2",
    "check",
    "chevron-down",
    "clock",
    "cloud",
    "code",
    "file-text",
    "gauge",
    "git-branch",
    "git-compare",
    "globe",
    "history",
    "layers",
    "layout-dashboard",
    "lightbulb",
    "link",
    "list-checks",
    "lock",
    "log-out",
    "map",
    "menu",
    "message-square",
    "network",
    "plug",
    "route",
    "scale",
    "search",
    "shield-check",
    "sparkles",
    "target",
    "user",
    "users",
    "workflow",
    "x"
  ]
}
