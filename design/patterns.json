{
  "pilot_patterns": {
    "overview": {
      "pattern": "dashboard-01",
      "structure": [
        "kpi-band",
        "answer-cascade",
        "chart",
        "dense-table"
      ]
    },
    "list": {
      "pattern": "data-table",
      "structure": [
        "action-bar",
        "quiet-alert",
        "dense-table"
      ]
    },
    "focused_task": {
      "pattern": "command",
      "structure": [
        "large-input",
        "suggestion-chips",
        "answer-cascade"
      ]
    },
    "form": {
      "pattern": "single-column",
      "structure": [
        "page-header",
        "form-body",
        "form-footer"
      ],
      "rules": [
        "label-above-input",
        "inline-validation",
        "right-aligned-actions"
      ]
    },
    "dialog": {
      "pattern": "centered-modal",
      "structure": [
        "overlay",
        "dialog-header",
        "dialog-body",
        "dialog-footer"
      ],
      "rules": [
        "no-shadows",
        "hairline-border",
        "8px-radius"
      ]
    },
    "matrix": {
      "pattern": "dense-table-matrix",
      "parent": "dense-table",
      "spec": {
        "sticky_header": true,
        "sticky_left_column": true,
        "pagination": false,
        "cell_states": [
          "empty",
          "single-value",
          "multiple-count",
          "not-recorded"
        ],
        "legend_required": true,
        "filters": "form_field"
      },
      "banned": [
        "observable",
        "d3-chord",
        "d3-sankey",
        "composer-matrix",
        "paginated-matrix"
      ]
    }
  },
  "banned_patterns": [
    "card-grid-navigation",
    "accordion-faq",
    "equal-weight-action-bars",
    "full-width-warning-banners",
    "multi-column-forms",
    "drop-shadows",
    "icons-inside-kpi-cards",
    "mermaid",
    "force-directed-graph",
    "page-level-d3",
    "side-drawers",
    "full-screen-modals",
    "floating-labels",
    "observable",
    "d3-chord",
    "d3-sankey",
    "composer-matrix",
    "paginated-matrix"
  ]
}
