{
  "pilot_patterns": {
    "overview": {
      "pattern": "dashboard-01",
      "structure": [
        "kpi-band",
        "answer-cascade",
        "chart",
        "dense-table"
      ]
    },
    "list": {
      "pattern": "data-table",
      "structure": [
        "action-bar",
        "quiet-alert",
        "dense-table"
      ]
    },
    "focused_task": {
      "pattern": "command",
      "structure": [
        "large-input",
        "suggestion-chips",
        "answer-cascade"
      ]
    },
    "form": {
      "pattern": "single-column",
      "structure": [
        "page-header",
        "form-body",
        "form-footer"
      ],
      "rules": [
        "label-above-input",
        "inline-validation",
        "right-aligned-actions"
      ]
    },
    "dialog": {
      "pattern": "centered-modal",
      "structure": [
        "overlay",
        "dialog-header",
        "dialog-body",
        "dialog-footer"
      ],
      "rules": [
        "no-shadows",
        "hairline-border",
        "8px-radius"
      ]
    },
    "matrix": {
      "pattern": "dense-table-matrix",
      "parent": "dense-table",
      "spec": {
        "sticky_header": true,
        "sticky_left_column": true,
        "pagination": false,
        "cell_states": [
          "empty",
          "single-value",
          "multiple-count",
          "not-recorded"
        ],
        "legend_required": true,
        "filters": "form_field",
        "one_value_kind_per_grid": "a matrix shows one kind of value in every filled cell: a count matrix shows numbers (a single relationship reads 1, its type in the cell title); a label matrix shows labels",
        "row_header": "sentence case, 14px, weight 500, normal tracking (not the column headers' uppercase)"
      },
      "banned": [
        "observable",
        "d3-chord",
        "d3-sankey",
        "composer-matrix",
        "paginated-matrix"
      ]
    },
    "sidebar": {
      "pattern": "sidebar-group",
      "children": [
        "sidebar-collapsible"
      ],
      "macros": "components/sidebar_nav.html: sidebar_group, sidebar_item, sidebar_collapsible, sidebar_subitem",
      "spec": {
        "levels": 2,
        "group_heading": "10px, weight 600, uppercase, 0.08em tracking, muted, role=heading level 3",
        "item": "32px row, 13px, 16px icon, 8px horizontal padding, 6px radius",
        "item_active": "muted surface, info text, weight 500, aria-current=page",
        "collapsible": "the item row as a button with a 14px chevron that turns 90 degrees when open; aria-expanded and aria-controls; opening one never closes another",
        "subitem": "28px row, 13px, no icon, indented 32px under the parent icon, aria-current=page when active",
        "count": "right-aligned 11px tabular figure, muted",
        "pending": "right-aligned 16px primary badge with the figure, aria-label '<n> pending'; replaces the count",
        "open_state": "persisted per item id in localStorage (archie_sidebar_group_<id>); a collapsible whose child is the current page is always open",
        "collapsed_rail": "the existing 4rem collapsed state hides labels, counts and sub-lists; the rail with flyouts is sidebar-rail (P2), not this pattern"
      },
      "banned": [
        "sidebar-third-level",
        "exclusive-accordion",
        "hover-flyout-on-desktop"
      ]
    },
    "site_nav": {
      "pattern": "disclosure-navigation",
      "structure": [
        "skip-link",
        "wordmark",
        "top-level-entries",
        "site-cta",
        "account"
      ],
      "rules": [
        "registry-driven",
        "sticky-h-16-hairline",
        "no-shadow",
        "one-site-primary",
        "disclosure-not-menu-role"
      ],
      "spec": {
        "height": "h-16",
        "breakpoint": "lg",
        "mobile": "header-disclosure-panel",
        "cta": "primary, data-site-cta",
        "signin": "ghost",
        "registry": "content/site/registry.yml read by site_registry()"
      },
      "banned": [
        "side-drawers",
        "full-screen-modals",
        "drop-shadows",
        "literal-link-lists"
      ]
    },
    "mega_menu": {
      "pattern": "grouped-icon-rows",
      "parent": "site_nav",
      "structure": [
        "group-heading",
        "item-row",
        "see-all",
        "early-access-group"
      ],
      "spec": {
        "item": "icon + label + blurb<=80 chars",
        "max_items_per_group": 8,
        "early_access_group": "last, dashed hairline, muted icon, heading Coming soon"
      },
      "banned": [
        "card-grid-navigation",
        "tooltip-only-descriptions"
      ]
    },
    "site_footer": {
      "pattern": "site-map",
      "structure": [
        "brand-line",
        "registry-rows",
        "bottom-bar"
      ],
      "rules": [
        "registry-driven",
        "max-12-links-per-column",
        "links-look-like-links",
        "coming-soon-column-last",
        "labels-equal-navbar-labels"
      ],
      "banned": [
        "literal-link-lists",
        "fake-link-spans"
      ]
    }
  },
  "banned_patterns": [
    "card-grid-navigation",
    "accordion-faq",
    "equal-weight-action-bars",
    "full-width-warning-banners",
    "multi-column-forms",
    "drop-shadows",
    "icons-inside-kpi-cards",
    "mermaid",
    "force-directed-graph",
    "page-level-d3",
    "side-drawers",
    "full-screen-modals",
    "floating-labels",
    "observable",
    "d3-chord",
    "d3-sankey",
    "composer-matrix",
    "paginated-matrix",
    "sidebar-third-level",
    "exclusive-accordion",
    "literal-link-lists",
    "fake-link-spans",
    "placeholder-screenshots",
    "screenshots-on-early-access",
    "gradient-backgrounds",
    "decorative-blur",
    "hover-lift"
  ],
  "public_scope": [
    "app/templates/components/public_navbar.html",
    "app/templates/components/public_menu.html",
    "app/templates/components/public_footer.html"
  ],
  "public_icons": [
    "arrow-right",
    "arrow-up-right",
    "book-open",
    "boxes",
    "building-2",
    "check",
    "chevron-down",
    "clock",
    "cloud",
    "code",
    "file-text",
    "gauge",
    "git-branch",
    "git-compare",
    "globe",
    "history",
    "layers",
    "layout-dashboard",
    "lightbulb",
    "link",
    "list-checks",
    "lock",
    "log-out",
    "map",
    "menu",
    "message-square",
    "network",
    "plug",
    "route",
    "scale",
    "search",
    "shield-check",
    "sparkles",
    "target",
    "user",
    "users",
    "workflow",
    "x"
  ]
}
