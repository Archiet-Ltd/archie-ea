# Copy to .env and set real values. NEVER commit .env (it is gitignored).
# The app loads this file at startup via python-dotenv.
# NOTE: the app selects its config from FLASK_CONFIG (development|production|testing),
# NOT the standard FLASK_ENV. Setting FLASK_ENV has no effect.

# ── Core ──────────────────────────────────────────────────────────────────────
# Use 'production' for any real deployment (DEBUG off, HTTPS-only secure cookies).
FLASK_CONFIG=development
# Generate a long random string, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-long-random-string

# PostgreSQL is REQUIRED (there is no SQLite fallback). The bootstrap and schema
# owner credentials are used only by one-shot deployment jobs; web/worker
# processes receive only DATABASE_URL for the non-owner runtime role.
POSTGRES_PASSWORD=change-me-bootstrap-only
DATABASE_DEPLOY_PASSWORD=change-me-schema-owner-only
DATABASE_RUNTIME_PASSWORD=change-me-runtime-only
DATABASE_ADMIN_URL=postgresql://postgres:change-me-bootstrap-only@localhost:5432/postgres
DATABASE_DEPLOY_URL=postgresql://archie_deploy:change-me-schema-owner-only@localhost:5432/archie
DATABASE_URL=postgresql://archie_runtime:change-me-runtime-only@localhost:5432/archie
# HMAC key shared only by the schema-deploy and application processes. Generate
# with: python -c "import secrets; print(secrets.token_hex(32))"
# During rotation, deploy the new current key and retain the old key in the
# comma-separated previous list until every old app process has stopped.
TRANSFORMATION_COMMAND_CAPABILITY_SECRET=change-me-generate-64-hex-characters
# Optional typed ARB waiver-expiry scheduler. Tenant IDs must be explicit and
# each tenant needs a confirmed service user ID in the JSON principal map.
ARB_CONDITION_EXPIRY_CAPABILITY=
ARB_CONDITION_EXPIRY_PRINCIPALS={}
ARB_CONDITION_EXPIRY_ORGANIZATION_IDS=
ARB_CONDITION_EXPIRY_BATCH_SIZE=100
ARB_CONDITION_EXPIRY_INTERVAL_MINUTES=5
TRANSFORMATION_COMMAND_CAPABILITY_PREVIOUS_SECRETS=

# Redis — cache + background job queue. Needed for email sending and async imports.
REDISTOGO_URL=redis://localhost:6379

# First admin user (created by create_admin.py / `flask setup-prod`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-production

# Optional user ID for application-owner evidence requests created by the
# Transformation Room. Must identify a confirmed user in the programme tenant;
# absent or invalid values use the workstream lead.
TRANSFORMATION_PORTFOLIO_STEWARD_ID=

# ── Reverse proxy / HTTPS ─────────────────────────────────────────────────────
# Set both when running behind a TLS-terminating proxy (nginx/Caddy) so the app
# builds https:// URLs and marks session cookies Secure.
TRUST_PROXY=true
PREFERRED_URL_SCHEME=https

# ── AI / LLM providers ────────────────────────────────────────────────────────
# Set at least ONE provider key (or configure in-app under Admin > API Settings).
# The app fails over across whichever providers are configured.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=

# ── Semantic search / embeddings ──────────────────────────────────────────────
# Use the bundled local model (all-MiniLM-L6-v2): semantic search works with NO
# external key or cost. Requires the pgvector extension in Postgres:
#   CREATE EXTENSION IF NOT EXISTS vector;   (recommended image: pgvector/pgvector:pg15)
ENABLE_LOCAL_EMBEDDINGS=true
USE_PGVECTOR=true

# ── Stored-credential connectors (Jira, M365, ServiceNow, n8n) ─────────────────
# Fernet key that encrypts saved connector credentials. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without it, saving a connector fails. Do NOT change it once connectors are saved.
CREDENTIAL_ENCRYPTION_KEY=

# Per-organisation credential encryption master key. Used to wrap each
# organisation's Fernet key stored in OrganizationEncryptionKey. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without it, per-organisation credential storage refuses to store secrets.
ORG_ENCRYPTION_MASTER_KEY=

# ── Email (password reset, team invites, verification) ─────────────────────────
# Without valid SMTP credentials these flows silently no-op. Defaults to SendGrid SMTP.
MAIL_SERVER=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@example.com

# ── Background workers ─────────────────────────────────────────────────────────
# Enable to run large batch imports asynchronously (otherwise they run inline).
CELERY_ENABLED=false

# ── Optional integrations (also configurable in-app under Admin) ──────────────
# Billing / paid plans. The app runs fully without these; the billing page then
# says online payment is not set up. Use test-mode keys (sk_test_...) until launch.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=        # signing secret of the endpoint /admin/billing/webhook
# STRIPE_PRICE_STARTUP_MONTHLY=
# STRIPE_PRICE_STARTUP_ANNUAL=
# STRIPE_PRICE_TEAM_MONTHLY=    # per-editor price; quantity = editor seats
# STRIPE_PRICE_TEAM_ANNUAL=
# STRIPE_AUTOMATIC_TAX=false    # true once tax registrations are set up in Stripe
# STRIPE_API_BASE=             # testing only: a local provider mock such as stripe-mock
# ABACUS_BASE_URL=https://abacus.example.com

# ── Feature flags ──────────────────────────────────────────────────────────────
# NOTE: feature flags — e.g. the full ArchiMate "North Star" navigation
# (north_star_navigation / north_star_phase2) — live in the DB feature_flags table
# and are toggled under Admin > Feature Flags, NOT here.
