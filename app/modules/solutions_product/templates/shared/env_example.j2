{# app/modules/solutions_product/templates/shared/env_example.j2 #}
{# Local-dev environment template for the generated project. #}
{# Context: project_name, db_name, language, port, identity_provider, integrations #}
# GENERATED BY Entelim — copy to .env and fill in real values.
# Never commit a filled-in .env; this file only documents the shape.

# ── Application ─────────────────────────────────────────────────────────────
APP_NAME={{ project_name }}
ENV=development
PORT={{ port | default('8000') }}
LOG_LEVEL=info

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/{{ db_name | default(project_name ~ '_dev') }}
{% if language == 'python-fastapi' or language == 'python-flask' %}
DATABASE_POOL_SIZE=5
{% endif %}

# ── Security ────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
{% if identity_provider %}

# ── Identity provider ({{ identity_provider.get('type', 'oidc') if identity_provider else 'oidc' }}) ──
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
{% if identity_provider.get('mfa') and identity_provider.get('mfa') != 'none' %}
MFA_REQUIRED=true
{% endif %}
{% endif %}
{% if integrations %}

# ── Integrations ────────────────────────────────────────────────────────────
{% for integration in integrations %}
{{ (integration.name if integration is mapping else integration) | upper | replace('-', '_') }}_API_KEY=
{% endfor %}
{% endif %}

# ── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
